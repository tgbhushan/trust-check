# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VIRUSTOTAL_API_KEY: Required for live VirusTotal API v3 queries (URLs, domains, IP addresses, file hashes).
# Add in AI Studio via Settings -> Secrets -> VIRUSTOTAL_API_KEY.
VIRUSTOTAL_API_KEY="MY_VIRUSTOTAL_API_KEY"

# GOOGLE_SAFE_BROWSING_API_KEY: Optional for live Google Safe Browsing Lookup API v4 queries.
# Add in AI Studio via Settings -> Secrets -> GOOGLE_SAFE_BROWSING_API_KEY, or configure in Owner Console.
GOOGLE_SAFE_BROWSING_API_KEY="MY_SAFE_BROWSING_API_KEY"

# VITE_API_URL: Optional backend origin (e.g., https://trustcheck-api.onrender.com)
# Use when deploying the frontend statically (GitHub Pages) while running the Express backend on a separate host.
VITE_API_URL=""


